# ============================================================
# Crypto Trading Bot System V4 — Environment Configuration
# ============================================================
# Copy this file to .env and fill in your real values.
# NEVER commit the real .env to version control!

# --- DATABASE ---
DB_NAME=cryptodata
DB_USER=dbfiller
DB_PASSWORD=your_secure_password_here
DB_HOST=localhost
DB_PORT=5432

# --- BINANCE API ---
BINANCE_API_KEY=your_binance_api_key_here
BINANCE_SECRET=your_binance_secret_here

# --- TELEGRAM ---
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Telegram Channel IDs (negative numbers for group/channel chats)
# Get channel ID by forwarding a message to @userinfobot

# --- Market Monitoring ---
PUMP_DUMP_MARKET_CHANNEL_ID=-100xxxxxxxxxx   # PD-1 market alerts
PUMP_DUMP_AI_CHANNEL_ID=-100xxxxxxxxxx       # EPD-1 AI pump detection
SENTIMENT_CHANNEL_ID=-100xxxxxxxxxx          # Market Tracker hourly reports

# --- Regime Orchestrator ---
REGIME_TRADING_CHANNEL_ID=-100xxxxxxxxxx
REGIME_STATUS_CHANNEL_ID=-100xxxxxxxxxx

# --- Classical Channel Bots ---
FIO1_CHANNEL_ID=-100xxxxxxxxxx    # FIO-1  (Fast In And Out)
VOL1_CHANNEL_ID=-100xxxxxxxxxx    # VOL-1  (Volume Indicator)
PCT5_CHANNEL_ID=-100xxxxxxxxxx    # PCT-5  (5 Percent)
SR1_CHANNEL_ID=-100xxxxxxxxxx     # SR-1   (Support Resistance)
MAIN1_CHANNEL_ID=-100xxxxxxxxxx   # MAIN-1 (Main Channel)

# --- MIS Bot Channels (one per horizon) ---
MIS_CHANNEL_8H=-100xxxxxxxxxx     # MIS-1-8h
MIS_CHANNEL_24H=-100xxxxxxxxxx    # MIS-1-24h
MIS_CHANNEL_72H=-100xxxxxxxxxx    # MIS-1-72h
MIS_CHANNEL_168H=-100xxxxxxxxxx   # MIS-1-168h

# --- AI Bots ---
ATS1_CHANNEL_ID=-100xxxxxxxxxx    # ATS-1
ATB1_CHANNEL_ID=-100xxxxxxxxxx    # ATB-1
AIM1_CHANNEL_ID=-100xxxxxxxxxx    # AIM-1
ABR1_CHANNEL_ID=-100xxxxxxxxxx    # ABR-1
RUB1_CHANNEL_ID=-100xxxxxxxxxx    # RUB-1
SRA1_CHANNEL_ID=-100xxxxxxxxxx    # SRA-1
EPD1_CHANNEL_ID=-100xxxxxxxxxx    # EPD-1
UFI1_CHANNEL_ID=-100xxxxxxxxxx    # UFI-1

# --- Pattern / SMC Bots ---
BB_CHANNEL_1H=-100xxxxxxxxxx      # BB-1h  (Breaker Block 1h)
BB_CHANNEL_4H=-100xxxxxxxxxx      # BB-4h  (Breaker Block 4h)
BR_CHANNEL_1H=-100xxxxxxxxxx      # BR-1h  (Breakout 1h)
BR_CHANNEL_2H=-100xxxxxxxxxx      # BR-2h  (Breakout 2h)
BR_CHANNEL_4H=-100xxxxxxxxxx      # BR-4h  (Breakout 4h)
BR_CHANNEL_1D=-100xxxxxxxxxx      # BR-1d  (Breakout 1d)
QM_CHANNEL_1H=-100xxxxxxxxxx      # QM-1h  (Quasimodo 1h)
QM_CHANNEL_4H=-100xxxxxxxxxx      # QM-4h  (Quasimodo 4h)
TD_CHANNEL_1H=-100xxxxxxxxxx      # TD-1h  (Three Drive 1h)
TD_CHANNEL_4H=-100xxxxxxxxxx      # TD-4h  (Three Drive 4h)

# --- SYSTEM ---
NUM_WORKERS=16
DASHBOARD_PORT=5000
