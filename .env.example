# ============================================================
# Crypto Trading Bot System V4 — Environment Configuration
# ============================================================
# Copy this file to .env and fill in your real values.
# NEVER commit the real .env to version control!

# --- DATABASE ---
DB_NAME=cryptodata
DB_USER=dbfiller
DB_PASSWORD=your_secure_password_here
DB_HOST=localhost
DB_PORT=5432

# --- BINANCE API ---
BINANCE_API_KEY=your_binance_api_key_here
BINANCE_SECRET=your_binance_secret_here

# --- TELEGRAM ---
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Telegram Channel IDs (negative numbers for group/channel chats)
# Get channel ID by forwarding a message to @userinfobot

# Strategy signal channels (Cornix listens here)
TELEGRAM_CHANNEL_FAST_IN_OUT=-100xxxxxxxxxx
TELEGRAM_CHANNEL_5_PERCENT=-100xxxxxxxxxx
TELEGRAM_CHANNEL_MAIN=-100xxxxxxxxxx
TELEGRAM_CHANNEL_SR=-100xxxxxxxxxx
TELEGRAM_CHANNEL_VOLUME=-100xxxxxxxxxx
TELEGRAM_CHANNEL_PATTERN=-100xxxxxxxxxx

# Regime Orchestrator channels
REGIME_TRADING_CHANNEL_ID=-100xxxxxxxxxx
REGIME_STATUS_CHANNEL_ID=-100xxxxxxxxxx

# Individual bot channels
UFI1_CHANNEL_ID=-100xxxxxxxxxx
AI_MASTER_CHANNEL_ID=-100xxxxxxxxxx
ATS_CHANNEL_ID=-100xxxxxxxxxx
RUBBERBAND_CHANNEL_ID=-100xxxxxxxxxx
ATB_CHANNEL_ID=-100xxxxxxxxxx
ATB_INFO_CHANNEL_ID=-100xxxxxxxxxx
ABR1_CHANNEL_ID=-100xxxxxxxxxx
BTC_SMC_CHANNEL_ID=-100xxxxxxxxxx
QUASIMODO_CHANNEL_ID=-100xxxxxxxxxx
MAYANK_CHANNEL_ID=-100xxxxxxxxxx
SMC_FOREX_XAUUSD_CHANNEL_ID=-100xxxxxxxxxx
SMC_FOREX_XAGUSD_CHANNEL_ID=-100xxxxxxxxxx

# Pump/Dump channels
PUMP_DUMP_MARKET_CHANNEL_ID=-100xxxxxxxxxx
PUMP_DUMP_AI_CHANNEL_ID=-100xxxxxxxxxx
PUMP_DUMP_MAIN_CHANNEL_ID=-100xxxxxxxxxx
SENTIMENT_CHANNEL_ID=-100xxxxxxxxxx

# MIS bot channels (keyed by horizon)
MIS_CHANNEL_1H=-100xxxxxxxxxx
MIS_CHANNEL_2H=-100xxxxxxxxxx
MIS_CHANNEL_4H=-100xxxxxxxxxx
MIS_CHANNEL_8H=-100xxxxxxxxxx

# --- SYSTEM ---
# Number of parallel workers for indicator engine (recommended: 8-16)
NUM_WORKERS=16

# Dashboard port
DASHBOARD_PORT=5000

